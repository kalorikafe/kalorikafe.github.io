* text=auto

# Deterministic generated catalogs and cross-platform scripts.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Media assets must never undergo text conversion.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff2 binary
