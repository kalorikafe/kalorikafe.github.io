{
  "name": "kalori_cafe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "catalog:build": "python -B scripts/compile_catalog.py",
    "catalog:check": "python -B scripts/compile_catalog.py --check",
    "catalog:drift": "node scripts/catalog-semantic-diff.mjs",
    "catalog:drift:test": "node --test tests/scripts/catalog-semantic-diff.test.mjs tests/scripts/fetch-caffe-nero.test.mjs",
    "catalog:export": "node --experimental-strip-types scripts/export-catalog.mjs",
    "predev": "npm run catalog:export",
    "dev": "vite",
    "prebuild": "npm run catalog:export",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/generate-static-pages.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "lint": "oxlint src scripts tests/unit tests/e2e tests/scripts playwright.config.ts",
    "catalog:audit": "node scripts/catalog-audit.ts",
    "catalog:fetch:caffe-nero": "node scripts/fetch-caffe-nero.mjs",
    "images:optimize": "node --experimental-strip-types scripts/optimize-menu-images.mjs",
    "images:audit": "node --experimental-strip-types scripts/image-integrity.mjs --strict --output tmp/image-integrity.json",
    "test": "npm run catalog:audit && npm run images:audit && npm run lint && npm run test:unit && npm run build && npm run verify:build && npm run budget:check && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
